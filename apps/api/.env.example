ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./career_agent.db
AUTO_CREATE_SCHEMA=true
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
AI_PROVIDER=deterministic
# Set only the key for the selected provider.
OPENAI_API_KEY=
MISTRAL_API_KEY=
AI_MODEL=gpt-5.6-sol
# Dedicated HMAC secret required with any external provider in production.
AI_SAFETY_SALT=
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=800
RESUME_AI_MAX_OUTPUT_TOKENS=4000
MAX_IMPORT_BYTES=10000000
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
