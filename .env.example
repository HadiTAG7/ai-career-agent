# Docker Compose / PostgreSQL configuration. Copy to .env only when using Compose.
# The Windows native launcher creates app-specific SQLite settings automatically.
# Never commit .env.
COMPOSE_PROJECT_NAME=ai-career-agent

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=3000

# SECURITY: header-based identity for local development only. Without Clerk configured
# and with this flag false, the API rejects every request (fail closed). Never enable
# outside a local machine; production refuses to start when it is true.
DEV_AUTH_BYPASS=true
NEXT_PUBLIC_DEV_AUTH_BYPASS=true

# PostgreSQL (local-only placeholder credentials)
POSTGRES_DB=career_agent
POSTGRES_USER=career_agent
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432
# localhost supports running the API natively; Compose injects its internal host.
DATABASE_URL=postgresql+asyncpg://career_agent:replace-with-a-local-only-password@localhost:5432/career_agent
# Compose applies Alembic migrations on API start; set true only for throwaway local databases.
AUTO_CREATE_SCHEMA=false

# Browser-to-API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Clerk. Empty values are accepted only in local development.
# Production must use dashboard-managed values; do not place real values here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# The deterministic provider keeps local development offline and reproducible.
# A real AI provider must pass privacy, data-transfer, and no-training review first.
AI_PROVIDER=deterministic
# Set only the key for the selected provider.
OPENAI_API_KEY=
MISTRAL_API_KEY=
AI_MODEL=gpt-5.6-sol
# Dedicated HMAC secret for privacy-preserving safety identifiers. Required with external AI in production.
AI_SAFETY_SALT=
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=800
RESUME_AI_MAX_OUTPUT_TOKENS=4000
# Optional per-flow model overrides; empty uses AI_MODEL.
RESUME_INTERVIEW_MODEL=
RESUME_WRITER_MODEL=

MAX_IMPORT_BYTES=10000000
